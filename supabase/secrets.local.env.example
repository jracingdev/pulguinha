# Copie para secrets.local.env e preencha (NÃO commite secrets.local.env)
# Depois rode: .\scripts\configurar-secrets-parceiros.ps1
# Deploy: .\scripts\deploy-wellhub.ps1

# GymPass / Wellhub (Access Control + Booking API)
# NÃO grave o bearer token (api_key) em arquivo commitado.
WELLHUB_BEARER_TOKEN=
# Produção — unidade Funcional do Pulguinha (X-Gym-Id):
WELLHUB_GYM_ID=824346
WELLHUB_SANDBOX=false
# Sandbox (credenciais de teste do e-mail Wellhub):
# WELLHUB_GYM_ID=683
# WELLHUB_SANDBOX=true
# Secret HMAC-SHA1 do webhook (enviar o mesmo valor à Wellhub). Máx. 100 chars.
WELLHUB_WEBHOOK_SECRET=
# Opcional: product_id da unidade (GET /setup/v1/gyms/{gymId}/products). Vazio = primeiro produto presencial.
WELLHUB_PRODUCT_ID=

# TotalPass (Access Control API)
TOTALPASS_API_KEY=
TOTALPASS_SERVICE_PROVIDER_CODE=
TOTALPASS_PLAN_CODE=
TOTALPASS_SANDBOX=false
